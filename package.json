{
  "name": "reconnect-batavia",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "bake": "node tools/bake-terrain.mjs",
    "render:truck": "node tools/render-truck.mjs",
    "cut:portraits": "node tools/cut-portraits.mjs",
    "make:portraits": "node tools/make-portraits.mjs",
    "check:script": "esbuild tools/script-check.ts --bundle --resolve-extensions=.ts,.tsx,.js --format=esm --platform=node --loader:.svg=text --loader:.png=text --outfile=node_modules/.cache/script-check.mjs --log-level=error && node node_modules/.cache/script-check.mjs",
    "check:routes": "esbuild tools/route-check.ts --bundle --resolve-extensions=.ts,.tsx,.js --format=esm --platform=node --loader:.svg=text --loader:.png=text --outfile=node_modules/.cache/route-check.mjs --log-level=error && node node_modules/.cache/route-check.mjs",
    "balance:survey": "esbuild tools/survey-balance.ts --bundle --resolve-extensions=.ts,.tsx,.js --format=esm --platform=node --loader:.svg=text --loader:.png=text --outfile=node_modules/.cache/survey-balance.mjs --log-level=error && node node_modules/.cache/survey-balance.mjs",
    "pixelate": "node tools/pixelate.mjs",
    "check:onebit": "esbuild tools/onebit-check.ts --bundle --resolve-extensions=.ts,.tsx,.js --format=esm --platform=node --outfile=node_modules/.cache/onebit-check.mjs --log-level=error && node node_modules/.cache/onebit-check.mjs",
    "fetch:photos": "esbuild tools/fetch-photos.ts --bundle --resolve-extensions=.ts,.tsx,.js --format=esm --platform=node --outfile=node_modules/.cache/fetch-photos.mjs --log-level=error && node node_modules/.cache/fetch-photos.mjs",
    "check:routing": "esbuild tools/routing-check.ts --bundle --resolve-extensions=.ts,.tsx,.js --format=esm --platform=node --loader:.svg=text --loader:.png=text --outfile=node_modules/.cache/routing-check.mjs --log-level=error && node node_modules/.cache/routing-check.mjs",
    "check:relay": "esbuild tools/relay-check.ts --bundle --resolve-extensions=.ts,.tsx,.js --format=esm --platform=node --loader:.svg=text --loader:.png=text --outfile=node_modules/.cache/relay-check.mjs --log-level=error && node node_modules/.cache/relay-check.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.6.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "three": "^0.185.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
